region           = "nyc3"
instance_type    = "s-1vcpu-1gb"
ssh_key_name     = "YOUR_EXISTING_DIGITALOCEAN_SSH_KEY_NAME"
ssh_allowed_cidr = "YOUR_PUBLIC_IP/32"
wireguard_port   = 51820

# Generated by the desktop app for each deployment. For CLI use, generate these
# with WireGuard tooling; never commit the real values.
server_private_key = "PLACEHOLDER_PRIVATE_KEY"
server_public_key  = "PLACEHOLDER_PUBLIC_KEY"
client_public_key  = "PLACEHOLDER_CLIENT_PUBLIC_KEY"

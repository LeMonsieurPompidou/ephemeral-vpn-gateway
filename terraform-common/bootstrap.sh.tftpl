#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

READY_MARKER=/var/lib/ephemeral-vpn/ready
FAILURE_MARKER=/var/lib/ephemeral-vpn/bootstrap-failure
STATUS_MARKER=/var/lib/ephemeral-vpn/bootstrap-status
BOOTSTRAP_BUILD=@@BOOTSTRAP_FINGERPRINT@@
phase="prerequisite installation"
command_category="bootstrap-initialization"

record_bootstrap_failure() {
  local code="$1" line="$2" diagnostic temporary
  trap - ERR
  diagnostic="ephemeral-vpn bootstrap failure: phase=${phase} category=${command_category} exit=${code} line=${line} build=${BOOTSTRAP_BUILD}"
  echo "${diagnostic}" >&2
  if install -d -m 0755 "$(dirname "${FAILURE_MARKER}")"; then
    temporary="${FAILURE_MARKER}.tmp"
    if printf '%s\n' "${diagnostic}" > "${temporary}" && chmod 0644 "${temporary}"; then
      if ! mv -f "${temporary}" "${FAILURE_MARKER}"; then
        echo "ephemeral-vpn bootstrap: could not persist failure diagnostic" >&2
      fi
    fi
  fi
  exit "${code}"
}

record_bootstrap_status() {
  local temporary
  temporary="${STATUS_MARKER}.tmp"
  printf 'build=%s\nphase=%s\nupdated_epoch=%s\n' \
    "${BOOTSTRAP_BUILD}" "${phase}" "$(date -u +%s)" > "${temporary}"
  chmod 0644 "${temporary}"
  mv -f "${temporary}" "${STATUS_MARKER}"
}

trap 'record_bootstrap_failure "$?" "$LINENO"' ERR
install -d -m 0755 /var/lib/ephemeral-vpn
rm -f "${READY_MARKER}"
rm -f "${FAILURE_MARKER}"
rm -f "${STATUS_MARKER}"
record_bootstrap_status
echo "ephemeral-vpn bootstrap build: ${BOOTSTRAP_BUILD}"
echo "ephemeral-vpn bootstrap phase: ${phase}"
export DEBIAN_FRONTEND=noninteractive
if ! command -v wg >/dev/null || ! command -v wg-quick >/dev/null || ! command -v iptables >/dev/null; then
  echo "ephemeral-vpn bootstrap: refreshing package indexes"
  command_category="apt-get-update"
  if apt-get update; then
    echo "ephemeral-vpn bootstrap: package indexes refreshed"
  else
    package_status=$?
    echo "ephemeral-vpn bootstrap: apt-get update failed (exit ${package_status})" >&2
    record_bootstrap_failure "${package_status}" "${LINENO}"
  fi

  # Ubuntu Noble's APT hook runs needrestart in automatic mode. Suspend that
  # scanner for this transaction; SSH is validated and restarted explicitly
  # in the controlled phase below. Other APT/dpkg failures remain fatal.
  echo "ephemeral-vpn bootstrap: automatic needrestart hook suspended for prerequisite installation"
  command_category="apt-get-install"
  if NEEDRESTART_SUSPEND=1 apt-get install -y iptables wireguard; then
    echo "ephemeral-vpn bootstrap: package installation completed"
  else
    package_status=$?
    echo "ephemeral-vpn bootstrap: package installation failed (apt-get exit ${package_status}); inspect preceding apt/dpkg output" >&2
    record_bootstrap_failure "${package_status}" "${LINENO}"
  fi
else
  echo "ephemeral-vpn bootstrap: prerequisite packages already present"
fi
command_category="prerequisite-validation"
command -v systemctl >/dev/null
command -v iptables >/dev/null
command -v wg >/dev/null
command -v wg-quick >/dev/null

phase="SSH hardening/configuration"
command_category="ssh-configuration"
record_bootstrap_status
echo "ephemeral-vpn bootstrap phase: ${phase}"
install -d -m 0755 /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/99-ephemeral-vpn.conf <<'SSH_CONFIG'
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
SSH_CONFIG
chmod 0644 /etc/ssh/sshd_config.d/99-ephemeral-vpn.conf
command -v sshd >/dev/null
command_category="ssh-config-validation"
sshd -t

# On-disk unit inspection can disagree with the running manager until
# daemon-reload. Query the manager's LoadState instead.
systemctl daemon-reload
resolve_ssh_service() {
  local attempt candidate load_state
  for attempt in 1 2 3 4 5; do
    for candidate in ssh.service sshd.service; do
      load_state="$(systemctl show --property=LoadState --value "${candidate}" 2>/dev/null || true)"
      if [ -z "${load_state}" ]; then
        load_state="unknown"
      fi
      printf 'ephemeral-vpn ssh unit: attempt=%s unit=%s LoadState=%s\n' \
        "${attempt}" "${candidate}" "${load_state}" >&2
      if [ "${load_state}" = "loaded" ]; then
        printf '%s\n' "${candidate}"
        return 0
      fi
    done
    if [ "${attempt}" -lt 5 ]; then
      sleep 1
    fi
  done
  return 1
}

command_category="ssh-service-resolution"
if ! ssh_service="$(resolve_ssh_service)"; then
  echo "ephemeral-vpn bootstrap: no loaded OpenSSH systemd service found" >&2
  record_bootstrap_failure 1 "${LINENO}"
fi
echo "ephemeral-vpn ssh unit selected: ${ssh_service}"
command_category="ssh-service-restart"
systemctl restart "${ssh_service}"
command_category="ssh-service-active-verification"
systemctl is-active --quiet "${ssh_service}"

phase="WireGuard configuration"
command_category="wireguard-configuration"
record_bootstrap_status
echo "ephemeral-vpn bootstrap phase: ${phase}"
install -d -m 0700 /etc/wireguard
cat > /etc/wireguard/wg0.conf <<'WG_CONFIG'
[Interface]
Address = 10.8.0.1/24
ListenPort = @@WIREGUARD_PORT@@
PrivateKey = @@SERVER_PRIVATE_KEY@@
PostUp = OUTBOUND_IFACE="$(ip route show default | awk '/default/ {print $5; exit}')"; iptables -A FORWARD -i wg0 -j ACCEPT; iptables -A FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -A POSTROUTING -o "$OUTBOUND_IFACE" -j MASQUERADE
PostDown = OUTBOUND_IFACE="$(ip route show default | awk '/default/ {print $5; exit}')"; iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -D POSTROUTING -o "$OUTBOUND_IFACE" -j MASQUERADE

@@CLIENT_PEERS@@
WG_CONFIG
chmod 0600 /etc/wireguard/wg0.conf
wg-quick strip wg0 >/dev/null

phase="forwarding/NAT/sysctl"
command_category="forwarding-nat-sysctl"
record_bootstrap_status
echo "ephemeral-vpn bootstrap phase: ${phase}"
cat > /etc/sysctl.d/99-wireguard.conf <<'SYSCTL_CONFIG'
net.ipv4.ip_forward=1
SYSCTL_CONFIG
chmod 0644 /etc/sysctl.d/99-wireguard.conf
sysctl --system >/dev/null
test "$(sysctl -n net.ipv4.ip_forward)" = 1
OUTBOUND_IFACE="$(ip route show default | awk '/default/ {print $5; exit}')"
test -n "${OUTBOUND_IFACE}"

phase="WireGuard service enable/start"
command_category="wireguard-service-start"
record_bootstrap_status
echo "ephemeral-vpn bootstrap phase: ${phase}"
systemctl enable --now wg-quick@wg0

phase="final readiness validation"
command_category="final-readiness-validation"
record_bootstrap_status
echo "ephemeral-vpn bootstrap phase: ${phase}"
systemctl is-enabled --quiet wg-quick@wg0
systemctl is-active --quiet wg-quick@wg0
wg show wg0 >/dev/null
ip link show wg0 >/dev/null
test "$(sysctl -n net.ipv4.ip_forward)" = 1
iptables -C FORWARD -i wg0 -j ACCEPT
iptables -t nat -C POSTROUTING -o "${OUTBOUND_IFACE}" -j MASQUERADE
ss -H -lun 'sport = :@@WIREGUARD_PORT@@' | grep -q .
install -d -m 0755 /var/lib/ephemeral-vpn
touch "${READY_MARKER}"
echo "ephemeral-vpn bootstrap complete"
